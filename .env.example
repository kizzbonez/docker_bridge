# Copy to .env to override the defaults in docker-compose.yml. Everything is optional.

# Host port for the site. Always bound to 127.0.0.1.
DASHBOARD_PORT=8742

# true: the simulated showcase at /showcase/ is public, and is what a visitor
# without a session sees at "/". It holds made-up containers and logs only.
# The console, its API, the documentation and the account page stay behind
# sign-in either way.
PUBLIC_SHOWCASE=false

# Who may show this site inside a frame (an <iframe> on another page).
# none: nobody. Otherwise "self" and/or https origins, separated by spaces,
# for example: https://portfolio.example.com
# Only name sites you control: whoever frames the site can lay their own page
# over it. A bare wildcard and plain http origins are refused.
FRAME_ANCESTORS=none

# One-time onboarding token. Leave empty to have a random one printed in
# `docker compose logs auth` on first start (recommended).
AUTH_SETUP_TOKEN=

# auto: mark the session cookie Secure whenever the visitor arrives over HTTPS.
# always: for deployments that are only ever reached through HTTPS.
AUTH_COOKIE_SECURE=auto

# Session lifetime and idle timeout.
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_IDLE_MINUTES=120

# Brute-force lockout: failures per client and account, and how long the lock lasts.
AUTH_MAX_FAILURES=5
AUTH_LOCKOUT_MINUTES=15

# ---- live console -----------------------------------------------------------

# Read-only: no state-changing command can be run. Set to false to allow the
# few the exec policy permits (for example `nginx -s reload`).
READ_ONLY_MODE=true

# false: no command at all can be run from the browser; the console only reads.
CONSOLE_EXEC=true

# Comma-separated compose projects. When set, the console sees nothing else.
DOCKER_BRIDGE_PROJECTS=

# The Docker socket on the host, and the group that owns it. Docker Desktop:
# leave as is. Linux: set the gid from `stat -c %g /var/run/docker.sock`.
DOCKER_SOCKET=/var/run/docker.sock
DOCKER_SOCKET_GID=0

# Where the MCP server writes its record of tool calls.
ACTIVITY_DIR=./data/activity
